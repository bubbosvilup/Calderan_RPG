node_modules/
# Generated by `npm run ui:build` (Vite production build of src/ui-client, served by the play server under /app/); disposable.
dist/
# Generated by `npm run build` (clean, then tsc --outDir .build); disposable, never source, never evidence.
.build/
# Runtime save root (campaigns, local playtests, live-harness scratch saves). Committed evidence lives under docs/evaluations/.
saves/
# Local, private tool output (raw provider responses, browser screenshots, private evaluation runs). Never committed.
artifacts/local/

# Local secrets (OpenRouter / Voyage keys are supplied via environment only)
.env
.env.*
*.env
*APIKEY*
*apikey*
*api_key*
*api-key*

# Logs, coverage and transient output
*.log
npm-debug.log*
coverage/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# robaccia
.tmp-*.log
