{
  "name": "caldrevan-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CaldrevanRPG deterministic narrative engine foundation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "play:ui": "npm run build --silent && node .build/src/ui/play.js",
    "inspect:save": "npm run build --silent && node .build/src/dev/inspect/inspect-save.js",
    "inspect:embedding": "npm run build --silent && node .build/src/dev/inspect/inspect-embedding.js",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs && tsc --noEmit false --outDir .build",
    "check:architecture": "node scripts/minor-debt-cycle-check.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "test": "npm run build && node --test .build/tests/*.test.js",
    "inspect:time": "npm run build --silent && node .build/src/dev/inspect/inspect-time.js",
    "inspect:scene": "npm run build --silent && node .build/src/dev/inspect/inspect-scene-state.js",
    "inspect:context": "npm run build --silent && node .build/src/dev/inspect/inspect-context.js",
    "inspect:search": "npm run build --silent && node .build/src/dev/inspect/inspect-search.js",
    "eval:retrieval": "npm run build --silent && node .build/tests/retrieval-eval/evaluate.js",
    "inspect:narrator": "npm run build --silent && node .build/src/dev/inspect/inspect-llm.js narrator",
    "inspect:controller": "npm run build --silent && node .build/src/dev/inspect/inspect-llm.js controller",
    "bench:llm": "npm run build --silent && node .build/src/dev/inspect/inspect-llm.js bench",
    "play": "npm run build --silent && node .build/src/dev/play.js",
    "test:playthrough": "npm run build --silent && node --test .build/tests/playthrough.test.js",
    "extract:playthrough": "npm run build --silent && node .build/src/dev/maintenance/extract-playthrough.js",
    "inspect:turn": "npm run build --silent && node .build/src/dev/live/eval-hardening.js --smoke",
    "review:playthrough": "npm run build --silent && node .build/src/dev/maintenance/review-playthrough.js",
    "benchmark:modern": "npm run build --silent && node .build/tests/benchmark/run.js",
    "benchmark:controller": "npm run build --silent && node .build/src/dev/benchmark/controller-benchmark.js"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
